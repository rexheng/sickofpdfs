{
  "name": "sickofpdfs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that takes over every PDF; pnpm monorepo root.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "fixtures": "node scripts/fixtures/build.mjs",
    "merge:wave": "node scripts/dev/merge-wave.mjs",
    "build": "pnpm -C apps/extension build",
    "e2e": "pnpm -C apps/extension build:e2e && playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jpeg-js": "0.4.4",
    "pdf-lib": "1.17.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "patchedDependencies": {
      "@embedpdf/engines@2.15.1": "patches/@embedpdf__engines@2.15.1.patch",
      "@embedpdf/pdfium@2.15.1": "patches/@embedpdf__pdfium@2.15.1.patch"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "preact",
        "svelte",
        "vue"
      ]
    }
  }
}
