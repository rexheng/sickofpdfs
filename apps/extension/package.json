{
  "name": "@sop/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The sickofpdfs Chrome extension (Manifest V3, built with WXT).",
  "scripts": {
    "postinstall": "wxt prepare",
    "assets": "node scripts/copy-engine-assets.mjs",
    "build": "node scripts/copy-engine-assets.mjs && wxt build",
    "build:e2e": "node scripts/copy-engine-assets.mjs && wxt build --mode test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wxt": "0.21.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "material-symbols": "0.48.2",
    "vite": "8.3.5"
  }
}
