    { "file": "NotoSans-Italic.ttf", "package": "@embedpdf/fonts-latin", "from": "fonts/NotoSans-Italic.ttf", "role": "latin", "weight": 400, "italic": true },
    { "file": "NotoSans-Bold.ttf", "package": "@embedpdf/fonts-latin", "from": "fonts/NotoSans-Bold.ttf", "role": "latin", "weight": 700, "italic": false },
    { "file": "NotoSans-BoldItalic.ttf", "package": "@embedpdf/fonts-latin", "from": "fonts/NotoSans-BoldItalic.ttf", "role": "latin", "weight": 700, "italic": true },
    { "file": "NotoSansHans-Regular.otf", "package": "@embedpdf/fonts-sc", "from": "fonts/NotoSansHans-Regular.otf", "role": "cjk", "weight": 400, "italic": false }
  ]
