{
  "name": "sop-spike-phase8-writeback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "THROWAWAY Phase 8 spike (8.0): writing annotations back into a PDF with our PDFium build, tail-only incremental save, and the Foxit/Acrobat file rules. Not part of the workspace.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
