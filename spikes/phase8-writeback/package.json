    "roundtrip": "node --experimental-transform-types --no-warnings --import ./loader/register.mjs scripts/roundtrip.ts",
    "matrix": "node --experimental-transform-types --no-warnings --import ./loader/register.mjs scripts/write-matrix.ts",
    "measure": "node --experimental-transform-types --no-warnings --import ./loader/register.mjs scripts/measure-save.ts"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@types/node": "22.20.5",
    "pdfjs-dist": "6.1.200"
  }
}
