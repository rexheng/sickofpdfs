{
  "name": "sop-spike-phase0",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "THROWAWAY Phase 0 engine proof: EmbedPDF 2.15.1 (PDFium) inside a Chrome MV3 extension.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "wxt build",
    "fixtures": "node scripts/fetch-fixtures.mjs && node scripts/make-paper50.mjs && node scripts/make-font-fixture.mjs",
    "fixtures:textlayer": "node scripts/make-textlayer-fixtures.mjs",
    "fixtures:scan": "node scripts/make-scan-fixture.mjs --source fixtures/out/classifier/learning/textbook-grinstead-snell-probability.pdf --pages 600 --dpi 200 --quality 60 --out fixtures/out/scan-600.pdf",
    "fixtures:objects": "node scripts/make-objects-fixture.mjs && node scripts/make-tagged-fixture.mjs",
    "report": "node scripts/report.mjs"
  },
  "dependencies": {
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/fonts-latin": "1.0.0",
    "@embedpdf/fonts-sc": "1.0.0",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-hebrew": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@playwright/test": "1.63.0",
    "jpeg-js": "0.4.4",
    "pdf-lib": "1.17.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wxt": "0.21.5"
  },
  "pnpm": {
    "patchedDependencies": {
      "@embedpdf/engines@2.15.1": "patches/@embedpdf__engines@2.15.1.patch"
    }
  }
}
